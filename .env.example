# demo = deterministic offline examples; gemini = live Google API calls.
AI_MODE=demo

# Keep your real key only in .env. GOOGLE_API_KEY is also accepted.
GEMINI_API_KEY=

# Configurable because model availability changes. Check with scripts/check_gemini.py.
GEMINI_WORKOUT_MODEL=gemini-3.8-flash
GEMINI_TIP_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=60

# Blank uses the project's absolute data/fitbuddy.db path.
DATABASE_URL=

# scripts/setup.py generates these secrets. Never commit .env.
SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# false for http://127.0.0.1; true only behind correctly configured HTTPS.
COOKIE_SECURE=false
